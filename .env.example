# Used by Docker Compose. npm run setup creates a private .env with random values.
DB_PASSWORD=replace-with-random-database-password
JWT_SECRET_KEY=replace-with-random-jwt-secret
NEXTAUTH_SECRET=replace-with-random-nextauth-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
MAIL_MODE=file
PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
