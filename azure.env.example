# Copy to .env on the Azure VM and fill the blanks. Never commit .env.
BRIDGE_DOMAIN=
DB_PASSWORD=
JWT_SECRET_KEY=
NEXTAUTH_SECRET=

# Add these before enabling Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side AI key.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# The sending mailbox. SMTP_PASSWORD must be a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
