APP_NAME=Project Bridge
API_V1_PREFIX=/api/v1
# SQLite is for local development. Use postgresql+asyncpg for PostgreSQL.
DB_DRIVER=sqlite+aiosqlite
DB_NAME=bridge.db
DB_HOST=localhost
DB_PORT=5433
DB_USER=bridge
DB_PASSWORD=
# Setup generates a random value. Never commit the actual .env.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GOOGLE_CLIENT_ID=

# Local accounts: file writes one-time links to backend/.tmp/mail-outbox.
# Use smtp plus provider credentials for real email delivery.
MAIL_MODE=file
PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Server-only AI credentials. Never put these in frontend/NEXT_PUBLIC variables.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=40
LLM_MAX_OUTPUT_TOKENS=4096
PATTERN_MIN_MESSAGES=3
PATTERN_MIN_CONVERSATIONS=2

